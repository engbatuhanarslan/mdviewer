{
  "name": "local-md-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Docker gerektirmeyen, yerel Markdown görüntüleyici",
  "scripts": {
    "start": "node server.mjs",
    "package:mac:arm": "pkg --targets node20-macos-arm64 --output dist/local-md-macos-arm64 server.cjs",
    "package:mac:intel": "pkg --targets node20-macos-x64 --output dist/local-md-macos-intel server.cjs",
    "package:windows": "pkg --targets node20-win-x64 --output dist/Local-MD.exe server.cjs",
    "package:linux": "pkg --targets node20-linux-x64 --output dist/local-md-linux server.cjs",
    "package:all": "npm run package:mac:arm && npm run package:mac:intel && npm run package:windows && npm run package:linux"
  },
  "pkg": {
    "assets": [
      "index.html",
      "app.js",
      "styles.css",
      "vendor/**/*"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.15.0"
  }
}
